---
import PageLayout from "../layouts/PageLayout.astro";
import ContentSection from "../components/ContentSection.astro";
import Button from "../components/Button.astro";
import ContentBlock from "../components/ContentBlock.astro";
import Image from "../components/Image.astro";
---

<PageLayout title="Home - HST Cultural Arts">
  <ContentSection color="home-hero">
    <ContentBlock>
      <h1>Welcome to HST Cultural Arts</h1>
      <p>Dance • Acting • Troupes • Tech</p>
    </ContentBlock>
  </ContentSection>
  <ContentSection>
    <ContentBlock>
      <h2>About HST</h2>
      <p>
        We are nonprofit children's theater organization dedicated to providing
        high quality arts programs where students can explore their talents,
        build confidence, and be part of something special.
      </p>
      <Button href="/about" title="Learn More" type="primary" />
    </ContentBlock>
    <ContentBlock>
      <Image
        src="/assets/brand/HST-logo-white-on-black.png"
        alt="HST Cultural Arts logo"
        size="medium"
        crop="natural"
        loading="lazy"
      />
    </ContentBlock>
  </ContentSection>
</PageLayout>
