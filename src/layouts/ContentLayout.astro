---
import PageLayout from "./PageLayout.astro";
import ContentSection from "../components/ContentSection.astro";

type ContentBlock = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: {
    href: string;
    title: string;
    type?: string;
  };
};

type Section = {
  color: "dark" | "light";
  type?: "default" | "timeline";
  layout?: "auto" | "1col" | "2cols" | "3cols" | "4cols" | "5cols";
  blocks?: ContentBlock[];
  years?: Array<{
    year: number | string;
    blocks?: Array<{
      block?: ContentBlock[];
    }>;
  }>;
};

type Frontmatter = {
  title: string;
  sections?: Section[];
};

const frontmatter = Astro.props.frontmatter as Frontmatter;
const { title, sections = [] } = frontmatter;
---

<PageLayout title={`${title} - HST Cultural Arts`}>
  {
    sections.map((section) => (
      <ContentSection
        color={section.color}
        type={section.type}
        layout={section.layout}
        blocks={section.blocks}
        years={section.years}
      />
    ))
  }
</PageLayout>
