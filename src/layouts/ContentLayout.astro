---
import "../styles/content-layout.css";
import PageLayout from "./PageLayout.astro";
import Button from "../components/Button.astro";
import ContentBlock from "../components/ContentBlock.astro";
import ContentSection from "../components/ContentSection.astro";
import MarkdownContent from "../components/MarkdownContent.astro";

type ButtonData = {
  href: string;
  title: string;
  type?: string;
};

type ContentBlockData = {
  heading?: string;
  text?: string;
  image?: {
    src: string;
    alt?: string;
  };
  button?: ButtonData;
};

type Section = {
  type: "hero" | "default";
  cols?: number;
  blocks?: ContentBlockData[];
};

type Frontmatter = {
  title: string;
  sections?: Section[];
};

const { title, sections = [] } =
  Astro.props.frontmatter as Frontmatter;
---

<PageLayout title={`${title} - HST Cultural Arts`}>
  {sections.map((section) => (
    <ContentSection type={section.type} cols={section.cols}>
      {section.blocks?.map((block) => (
        <ContentBlock>
          {block.heading &&
            (section.type === "hero" ? (
              <h1>{block.heading}</h1>
            ) : (
              <h2>{block.heading}</h2>
            ))}
          {block.text && <MarkdownContent text={block.text} />}
          {block.image?.src && (
            <img
              src={block.image.src}
              alt={block.image.alt ?? ""}
              loading="lazy"
            />
          )}
          {block.button && (
            <Button
              href={block.button.href}
              title={block.button.title}
              type={block.button.type ?? "primary"}
            />
          )}
        </ContentBlock>
      ))}
    </ContentSection>
  ))}
  <article class="content-page">
    <slot />
  </article>
</PageLayout>
