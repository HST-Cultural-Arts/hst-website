---
import PageLayout from "./PageLayout.astro";
import ContentSection from "../components/ContentSection.astro";

type ContentBlock = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: {
    href: string;
    title: string;
    type?: string;
  };
  embed?: {
    provider: "calendar" | "youtube";
    src: string;
    title: string;
    size?: "small" | "medium" | "large" | "full";
    height?: "short" | "medium" | "tall";
  };
  gallery?: Array<{
    src: string;
    alt?: string;
  }>;
  years?: Array<{
    year: number | string;
    blocks?: Array<{
      block?: ContentBlock[];
    }>;
  }>;
};

type Section = {
  color: "dark" | "light";
  heading?: string;
  layout?: "auto" | "1col" | "2cols" | "3cols" | "4cols" | "5cols";
  blocks?: ContentBlock[];
};

type Frontmatter = {
  title: string;
  sections?: Section[];
};

const frontmatter = Astro.props.frontmatter as Frontmatter;
const { title, sections = [] } = frontmatter;
---

<PageLayout title={`${title} - HST Cultural Arts`}>
  {
    sections.map((section) => (
      <ContentSection
        color={section.color}
        heading={section.heading}
        layout={section.layout}
        blocks={section.blocks}
      />
    ))
  }
</PageLayout>
