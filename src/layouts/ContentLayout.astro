---
import PageLayout from "./PageLayout.astro";
import Button from "../components/Button.astro";
import ContentBlock from "../components/ContentBlock.astro";
import ContentSection from "../components/ContentSection.astro";
import Image from "../components/Image.astro";
import Markdown from "../components/Markdown.astro";

type ButtonData = {
  href: string;
  title: string;
  type?: string;
};

type ContentBlockData = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: ButtonData;
};

type Section = {
  type: "hero" | "default";
  layout?: "auto" | "1col" | "2cols" | "3cols" | "4cols" | "5cols";
  blocks?: ContentBlockData[];
};

type Frontmatter = {
  title: string;
  sections?: Section[];
};

const { title, sections = [] } =
  Astro.props.frontmatter as Frontmatter;
---

<PageLayout title={`${title} - HST Cultural Arts`}>
  {sections.map((section) => (
    <ContentSection
      type={section.type}
      layout={section.layout}
    >
      {section.blocks?.map((block) => (
        <ContentBlock>
          {block.text && <Markdown text={block.text} />}
          {block.image?.src && (
            <Image
              src={block.image.src}
              alt={block.image.alt ?? ""}
              size={block.image.size}
              crop={block.image.crop}
            />
          )}
          {block.button && (
            <Button
              href={block.button.href}
              title={block.button.title}
              type={block.button.type ?? "primary"}
            />
          )}
        </ContentBlock>
      ))}
    </ContentSection>
  ))}
</PageLayout>
