---
import Button from "./Button.astro";
import Embed from "./Embed.astro";
import Gallery from "./Gallery.astro";
import Image from "./Image.astro";
import Markdown from "./Markdown.astro";
import Timeline from "./Timeline.astro";
import type { ContentBlock } from "../content.config";

const { block } = Astro.props as { block: ContentBlock };
---

{block.type === "text" && <Markdown text={block.text} />}

{block.type === "image" && block.src && (
  <Image
    src={block.src}
    alt={block.alt ?? ""}
    size={block.size}
    crop={block.crop}
  />
)}

{block.type === "button" && (
  <Button
    href={block.href}
    title={block.title}
    variant={block.variant ?? "primary"}
  />
)}

{block.type === "embed" && (
  <Embed
    provider={block.provider}
    src={block.src}
    title={block.title}
    size={block.size}
    height={block.height}
  />
)}

{block.type === "gallery" && block.images.length ? (
  <Gallery
    images={block.images}
    size={block.size}
    crop={block.crop}
    controls={block.controls}
    indicators={block.indicators}
    autoScroll={block.autoScroll}
    autoScrollInterval={block.autoScrollInterval}
    pauseOnHover={block.pauseOnHover}
  />
) : null}

{block.type === "timeline" && block.timeline?.length ? (
  <Timeline timeline={block.timeline} />
) : null}
