---
import "../styles/footer.css";
import footerData from "../data/footer.json";
import Brand from "./Brand.astro";

const currentYear = new Date().getFullYear();
const { brand, navigation } = footerData;
---

<footer>
  <div class="footer__inner">
    <div class="footer__brand">
      <Brand
        className="footer__logo"
        name={brand.name}
        logo={brand.logo}
        logoAlt={brand.logoAlt}
      />
      <p>{footerData.tagline}</p>
    </div>

    {navigation.columns.map((column) => (
      <nav class="footer__column" aria-label={column.heading}>
        <h2>{column.heading}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              {"href" in link ? <a href={link.href}>{link.label}</a> : <span>{link.label}</span>}
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="footer__bottom">
    <p>&copy; {currentYear} HST Cultural Arts. All rights reserved.</p>
  </div>
</footer>
