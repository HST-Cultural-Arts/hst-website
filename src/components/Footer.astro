---
import "../styles/footer.css";
import footerData from "../data/footer.json";

const currentYear = new Date().getFullYear();
const { brand, navigation } = footerData;
---

<footer>
  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href="/">
        <img
          src={brand.logo}
          alt={brand.logoAlt}
          width="273"
          height="179"
        />
        <h1>{brand.name}</h1>
      </a>
      <p>{brand.tagline}</p>
    </div>

    {navigation.columns.map((column) => (
      <nav class="footer__column" aria-label={column.heading}>
        <h2>{column.heading}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              {link.href ? <a href={link.href}>{link.label}</a> : <span>{link.label}</span>}
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="footer__bottom">
    <p>&copy; {currentYear} HST Cultural Arts. All rights reserved.</p>
  </div>
</footer>
