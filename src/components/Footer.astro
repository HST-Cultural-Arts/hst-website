---
import "../styles/footer.css";
import footer from "../data/footer.json";
---

<footer>
  <div class="footer__inner">
    <div class="footer__brand">
      <a class="footer__logo" href="/">
        <img
          src={footer.brand.logo}
          alt={footer.brand.logoAlt}
          width="273"
          height="179"
        />
        <h1>{footer.brand.name}</h1>
      </a>
      <p>
        {footer.brand.tagline}
      </p>
    </div>

    {footer.navigation.columns.map((column) => (
      <nav class="footer__column" aria-label={column.heading}>
        <h2>{column.heading}</h2>
        <ul>
          {
            column.links.map((link) => (
              <li>
                {"href" in link ? (
                  <a href={link.href}>{link.label}</a>
                ) : (
                  <span>{link.label}</span>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    ))}
  </div>

  <div class="footer__bottom">
    <p>&copy; 2026 HST Cultural Arts. All rights reserved.</p>
  </div>
</footer>
