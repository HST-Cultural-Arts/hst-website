---
import "../styles/content-section.css";
import "../styles/timeline.css";
const { color = "light", type = "default", layout = "auto" } = Astro.props;
---

<section
  class:list={[
    "content-section",
    `content-section--${color}`,
    `content-section--${type}`,
    `content-section-layout--${layout}`,
  ]}
>
  <slot />
</section>
