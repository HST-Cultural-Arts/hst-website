---
import "../styles/content-section.css";
import "../styles/timeline.css";
import ContentBlock from "./ContentBlock.astro";
import Gallery from "./Gallery.astro";
import Timeline from "./Timeline.astro";

type ContentBlockData = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: {
    href: string;
    title: string;
    type?: string;
  };
};

type TimelineYearData = {
  year: number | string;
  blocks?: Array<{
    block?: ContentBlockData[];
  }>;
};

type GalleryData = {
  src: string;
  alt?: string;
}[];

type Props = {
  color?: string;
  type?: string;
  layout?: string;
  blocks?: ContentBlockData[];
  years?: TimelineYearData[];
  gallery?: GalleryData;
};

const {
  color = "light",
  type = "default",
  layout = "auto",
  blocks = [],
  years = [],
  gallery = [],
} = Astro.props as Props;
---

<section
  class:list={[
    "content-section",
    `content-section--${color}`,
    `content-section--${type}`,
    `content-section-layout--${layout}`,
  ]}
>
  {type === "timeline" && <Timeline years={years} />}

  {type === "gallery" && <Gallery images={gallery} />}

  {type === "default" && blocks.length > 0 &&
    blocks.map((block) => <ContentBlock block={block} />)
  }
  <slot />
</section>
