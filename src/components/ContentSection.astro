---
import '../styles/content-section.css';
const { type = 'light', layout = 'auto' } = Astro.props;
const layoutClass = layout === 'auto'
    ? 'content-section-layout--auto'
    : layout
        ? `content-section-layout--${layout}`
        : '';
---

<section class={`content-section content-section--${type} ${layoutClass}`}>
    <slot />
</section>