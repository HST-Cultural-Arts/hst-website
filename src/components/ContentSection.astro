---
import "../styles/content-section.css";

import ContentBlock from "./ContentBlock.astro";
import type { Section } from "../content.config";

const {
  color = "light",
  heading,
  layout = "auto",
  blocks = [],
} = Astro.props as Section;
---

<section
  class:list={[
    "content-section",
    `content-section--${color}`,
  ]}
>
  {heading && <h2 class="content-section__heading">{heading}</h2>}

  <div class:list={["content-section__blocks", `content-section-layout--${layout}`]}>
    {blocks.length > 0 &&
      blocks.map((block) => <ContentBlock block={block} />)
    }
    <slot />
  </div>
</section>
