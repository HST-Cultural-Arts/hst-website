---
import "../styles/content-section.css";
import "../styles/timeline.css";
const {
  color = "light",
  type = "default",
  layout = "auto",
} = Astro.props;
const layoutClass = `content-section-layout--${layout}`;
---

<section class:list={[
  "content-section",
  `content-section--${color}`,
  `content-section--${type}`,
  layoutClass,
]}>
  <slot />
</section>
