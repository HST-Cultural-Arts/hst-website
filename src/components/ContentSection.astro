---
import "../styles/content-section.css";

import ContentBlock from "./ContentBlock.astro";

type ContentBlockData = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: {
    href: string;
    title: string;
    type?: string;
  };
  embed?: {
    provider: "calendar" | "youtube";
    src: string;
    title: string;
    size?: "small" | "medium" | "large" | "full";
    height?: "short" | "medium" | "tall";
  };
  gallery?: Array<{
    src: string;
    alt?: string;
  }>;
};

type Props = {
  color?: string;
  layout?: string;
  blocks?: ContentBlockData[];
};

const {
  color = "light",
  layout = "auto",
  blocks = [],
} = Astro.props as Props;
---

<section
  class:list={[
    "content-section",
    `content-section--${color}`,
    `content-section-layout--${layout}`,
  ]}
>
  {blocks.length > 0 &&
    blocks.map((block) => <ContentBlock block={block} />)
  }
  <slot />
</section>
