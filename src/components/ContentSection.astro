---
import "../styles/content-section.css";

import ContentBlock from "./ContentBlock.astro";
import type { ContentSection } from "../content.config";

const {
  color = "cream",
  layout = "auto",
  blocks = [],
  className = "",
} = Astro.props as ContentSection & { className?: string };
---

<section
  class:list={[
    "content-section",
    `content-section--${color}`,
    `content-layout--${layout}`,
    className,
  ]}
>
  {blocks.length > 0 && blocks.map((block) => <ContentBlock block={block} />)}
  <slot />
</section>
