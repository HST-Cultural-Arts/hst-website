---
import "../styles/content-block.css";
import Button from "./Button.astro";
import Image from "./Image.astro";
import Markdown from "./Markdown.astro";

type ButtonData = {
  href: string;
  title: string;
  type?: string;
};

type ContentBlockData = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: ButtonData;
};

const { block, className = "" } = Astro.props as {
  block?: ContentBlockData;
  className?: string;
};
---

<section class:list={["content-block", className]}>
  {block ? (
    <>
      {block.text && <Markdown text={block.text} />}

      {block.image?.src && (
        <Image
          src={block.image.src}
          alt={block.image.alt ?? ""}
          size={block.image.size}
          crop={block.image.crop}
        />
      )}

      {block.button && (
        <Button
          href={block.button.href}
          title={block.button.title}
          type={block.button.type ?? "primary"}
        />
      )}

    </>
  ) : (
    <slot />
  )}
</section>