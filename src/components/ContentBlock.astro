---
import "../styles/content-block.css";
import ContentBlockContent from "./ContentBlockContent.astro";
import type { ContentBlockData } from "../content.config";

const { block, className = "", variant = "transparent" } = Astro.props as {
  block?: ContentBlockData;
  className?: string;
  variant?: "transparent" | "card";
};

const blockVariant = block?.block ? "card" : variant;
const blockColor = block?.block?.color ?? "transparent";
---

<section
  class:list={[
    "content-block",
    `content-block--${blockVariant}`,
    `content-block-color--${blockColor}`,
    className,
  ]}
>
  {block ? (
    <>
      {block.block ? (
        block.block.blocks?.map((nestedBlock) => (
          <Astro.self block={nestedBlock} />
        ))
      ) : (
        <ContentBlockContent block={block} />
      )}

    </>
  ) : (
    <slot />
  )}
</section>