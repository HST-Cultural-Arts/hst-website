---
import "../styles/content-block.css";
import Button from "./Button.astro";
import Embed from "./Embed.astro";
import Gallery from "./Gallery.astro";
import Image from "./Image.astro";
import Markdown from "./Markdown.astro";
import Timeline from "./Timeline.astro";

type ButtonData = {
  href: string;
  title: string;
  type?: string;
};

type EmbedData = {
  provider: "calendar" | "youtube";
  src: string;
  title: string;
  size?: "small" | "medium" | "large" | "full";
  height?: "short" | "medium" | "tall";
};

type GalleryImage = {
  src: string;
  alt?: string;
};

type TimelineYear = {
  year: number | string;
  blocks?: Array<{
    href?: string;
    block?: ContentBlockData[];
  }>;
};

type ContentBlockData = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: ButtonData;
  embed?: EmbedData;
  gallery?: GalleryImage[];
  years?: TimelineYear[];
};

const { block, className = "" } = Astro.props as {
  block?: ContentBlockData;
  className?: string;
};
---

<section class:list={["content-block", className]}>
  {block ? (
    <>
      {block.text && <Markdown text={block.text} />}

      {block.image?.src && (
        <Image
          src={block.image.src}
          alt={block.image.alt ?? ""}
          size={block.image.size}
          crop={block.image.crop}
        />
      )}

      {block.button && (
        <Button
          href={block.button.href}
          title={block.button.title}
          type={block.button.type ?? "primary"}
        />
      )}

      {block.embed && (
        <Embed
          provider={block.embed.provider}
          src={block.embed.src}
          title={block.embed.title}
          size={block.embed.size}
          height={block.embed.height}
        />
      )}

      {block.gallery?.length ? <Gallery images={block.gallery} /> : null}

      {block.years?.length ? <Timeline years={block.years} /> : null}

    </>
  ) : (
    <slot />
  )}
</section>