---
import "../styles/content-block.css";
import ContentBlockContent from "./ContentBlockContent.astro";
import type { ContentBlock } from "../content.config";

const { block, className = "", variant = "default" } = Astro.props as {
  block?: ContentBlock;
  className?: string;
  variant?: "default" | "card" | "transparent";
};

const blockVariant =
  block?.type === "block" ? block.variant ?? variant : variant;
const blockColor =
  block?.type === "block" ? block.color ?? "transparent" : "transparent";
---

<section
  class:list={[
    "content-block",
    `content-block--${blockVariant}`,
    `content-block-color--${blockColor}`,
    className,
  ]}
>
  {block ? (
    <>
      {block.type === "block" ? (
        block.blocks?.map((nestedBlock) => (
          <Astro.self block={nestedBlock} />
        ))
      ) : (
        <ContentBlockContent block={block} />
      )}

    </>
  ) : (
    <slot />
  )}
</section>