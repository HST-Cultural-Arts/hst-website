---
import '../styles/header.css';
import headerData from '../data/header.json';
import Brand from './Brand.astro';

const { brand, navigation } = headerData;
---

<header>
    <Brand
        className="brand"
        name={brand.name}
        logo={brand.logo}
        logoAlt={brand.logoAlt}
    />
    <nav class="nav-links">
        <ul>
            {navigation.navLinks.map((link) => (
                <li>
                    <a href={link.href}>{link.label}</a>
                </li>
            ))}
        </ul>
    </nav>
    <nav class="cta-links">
        <ul>
            {navigation.ctaLinks.map((cta) => (
                <li>
                    <a class="header-cta" href={cta.href}>{cta.label}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>