---
import '../styles/header.css';
import headerData from '../data/header.json';

const { brand, navigation } = headerData;
---

<header>
    <a class="brand" href="/">
        <img src={brand.logo} alt={brand.logoAlt} width="273" height="179">
        <h1>{brand.name}</h1>
    </a>
    <nav class="nav-links">
        <ul>
            {navigation.navLinks.map((link) => (
                <li>
                    <a href={link.href}>{link.label}</a>
                </li>
            ))}
        </ul>
    </nav>
    <nav class="cta-links">
        <ul>
            {navigation.ctaLinks.map((cta) => (
                <li>
                    <a href={cta.href}>{cta.label}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>