---
import '../styles/header.css';
import header from '../data/header.json';
---

<header>
    <a class="brand" href="/"><img src={header.brand.logo} alt={header.brand.logoAlt} width="273" height="179"> <h1>{header.brand.name}</h1></a>
    <nav class="nav-links">
        <ul>
            {header.navigation.navLinks.map((link) => (
                <li>
                    <a href={link.href}>{link.label}</a>
                </li>
            ))}
        </ul>
    </nav>
    <nav class="cta-links">
        <ul>
            {header.navigation.ctaLinks.map((cta) => (
                <li>
                    <a href={cta.href}>{cta.label}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>