---
import '../styles/header.css';
const navLinks = [
    { name: 'Home', href: '/' },
    { name: 'About', href: '/about' },
    { name: 'Contact', href: '/contact' },
];

const ctaLinks = [
    { name: 'Support Us', href: '/support-us' },
    { name: 'Join Us', href: '/join-us' },
];
---

<header>
    <a class="brand" href="/"><img src="/assets/brand/HST-logo-white.png" alt="HST Cultural Arts" width="273" height="179"> <h1> Cultural Arts</h1></a>
    <nav class="nav-links">
        <ul>
            {navLinks.map((link) => (
                <li>
                    <a href={link.href}>{link.name}</a>
                </li>
            ))}
        </ul>
    </nav>
    <nav class="cta-links">
        <ul>
            {ctaLinks.map((cta) => (
                <li>
                    <a href={cta.href}>{cta.name}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>