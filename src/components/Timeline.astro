---
import ContentBlock from "./ContentBlock.astro";
import "../styles/timeline.css";
import type { TimelineYear } from "../content.config";

const { years = [] } = Astro.props as { years?: TimelineYear[] };
---

<div class="timeline">
  {years.map((year) => (
    <section class="timeline__year" aria-labelledby={`timeline-year-${year.year}`}>
      <div class="timeline__year-label" id={`timeline-year-${year.year}`}>
        <h2>{year.year}</h2>
      </div>

      {year.blocks?.length ? (
        <div class="timeline__entries">
          {year.blocks.map((card, cardIndex) => (
            <article
              class:list={[
                "timeline__card",
                cardIndex % 2 === 0
                  ? "timeline__card--left"
                  : "timeline__card--right",
              ]}
            >
              {card.block && (
                <ContentBlock
                  block={{ type: "block", block: card.block }}
                  variant="card"
                />
              )}
            </article>
          ))}
        </div>
      ) : null}
    </section>
  ))}
</div>
