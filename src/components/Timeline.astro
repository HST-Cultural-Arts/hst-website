---
import ContentBlock from "./ContentBlock.astro";
import "../styles/timeline.css";

type ContentBlockData = {
  text?: string;
  image?: {
    src: string;
    alt?: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "natural" | "landscape" | "square" | "portrait";
  };
  button?: {
    href: string;
    title: string;
    type?: string;
  };
};

type TimelineCard = {
  href?: string;
  block?: ContentBlockData[];
};

type TimelineYear = {
  year: number | string;
  blocks?: TimelineCard[];
};

const { years = [] } = Astro.props as {
  years?: TimelineYear[];
};
---

<div class="timeline">
  {years.map((year) => (
    <section class="timeline__year" aria-labelledby={`timeline-year-${year.year}`}>
      <div class="timeline__year-label" id={`timeline-year-${year.year}`}>
        <h2>{year.year}</h2>
      </div>

      {year.blocks?.length ? (
        <div class="timeline__entries">
          {year.blocks.map((card, cardIndex) => (
            <article
              class:list={[
                "timeline__card",
                cardIndex % 2 === 0
                  ? "timeline__card--left"
                  : "timeline__card--right",
              ]}
            >
              {card.href ? (
                <a href={card.href} class="timeline__card-link">
                  {card.block?.map((block) => <ContentBlock block={block} />)}
                </a>
              ) : (
                card.block?.map((block) => <ContentBlock block={block} />)
              )}
            </article>
          ))}
        </div>
      ) : null}
    </section>
  ))}
</div>
