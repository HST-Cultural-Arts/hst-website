---
import ContentBlock from "./ContentBlock.astro";
import "../styles/timeline.css";
import type { Timeline } from "../content.config";

const { timeline = [] } = Astro.props as { timeline?: Timeline[] };
---

<div class="timeline">
  {timeline.map((year) => (
    <section
      class="timeline__year"
      aria-labelledby={`timeline-year-${year.year}`}
    >
      <div
        class="timeline__year-label"
        id={`timeline-year-${year.year}`}
      >
        <h2>{year.year}</h2>
      </div>

      {year.blocks?.length ? (
        <div class="timeline__entries">
          {year.blocks.map((card, cardIndex) => (
            <article
              class:list={[
                "timeline__card",
                cardIndex % 2 === 0
                  ? "timeline__card--left"
                  : "timeline__card--right",
              ]}
            >
              <ContentBlock block={card} variant="card" />
            </article>
          ))}
        </div>
      ) : null}
    </section>
  ))}
</div>
